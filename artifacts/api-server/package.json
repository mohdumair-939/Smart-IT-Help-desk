{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uv run --project ../.. --no-sync uvicorn app.main:app --app-dir python --host 0.0.0.0 --port ${PORT:-8080}",
    "build": "uv run --project ../.. --no-sync python -m compileall -q python/app",
    "start": "uv run --project ../.. --no-sync uvicorn app.main:app --app-dir python --host 0.0.0.0 --port ${PORT:-8080}",
    "migrate": "uv run --project ../.. --no-sync alembic -c python/alembic.ini upgrade head",
    "create-staff-user": "PYTHONPATH=python uv run --project ../.. --no-sync python -m app.bootstrap_user",
    "test": "PYTHONPATH=python uv run --project ../.. --no-sync python -m unittest discover -s python/tests -v",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
